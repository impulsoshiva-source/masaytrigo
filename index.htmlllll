        <Reveal y={16} blur={false} delay={0.1}><p className="lead">Ordena hoy y recoge sin fila, o recibe tu pan en bicicleta por la Condesa.</p></Reveal>
        <Reveal y={16} blur={false} delay={0.18} className="final-ctas">
          <a className="btn btn-primary btn-lg" href={TIENDANUBE_URL} target="_blank" rel="noopener noreferrer" data-cursor="cta" onClick={() => track("click_tiendanube", { from: "final" })}>
            Ordena tu Pan en Línea <Ico.arrow width="18" height="18" />
          </a>
          <a className="btn btn-ghost btn-lg light" href={WA_LINK} target="_blank" rel="noopener noreferrer" onClick={() => track("click_whatsapp_order", { from: "final" })}>
            <Ico.wa width="17" height="17" /> Pedir por WhatsApp
          </a>
        </Reveal>
      </div>
    </section>
  );
}

