/* --------------------------- SCROLL DIRECTION -------------------------- */
const DirContext = createContext(1);
function useScrollDirection() {
  const { scrollY } = useScroll();
  const [dir, setDir] = useState(1);
  const last = useRef(0);
  useMotionValueEvent(scrollY, "change", (v) => {
    if (v > last.current + 6) setDir(1);
    else if (v < last.current - 6) setDir(-1);
    last.current = v;
  });
  return dir;
}

/* --------------------- BIDIRECTIONAL REVEAL PRIMITIVE ------------------- */
function Reveal({ children, className = "", style, delay = 0, y = 34, blur = true, amount = 0.18, scale = 0.99 }) {
  const ref = useRef(null);
  const reduced = useReducedMotion();
  const [state, setState] = useState("below");
  useEffect(() => {
    const el = ref.current;
    if (!el) return undefined;
    if (reduced) { setState("in"); return undefined; }
    const pct = Math.round(amount * 100);
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) setState("in");
        else setState(e.boundingClientRect.top > 0 ? "below" : "above");
      });
    }, { threshold: 0, rootMargin: `-${pct}% 0px -${pct}% 0px` });
    io.observe(el);
    return () => io.disconnect();
  }, [reduced, amount]);

  const poses = {
    in: { opacity: 1, y: 0, scale: 1, filter: "blur(0px)", transition: { duration: 0.9, ease: [0.22, 1, 0.36, 1], delay } },
    below: { opacity: 0, y, scale, filter: blur ? "blur(7px)" : "blur(0px)", transition: { duration: 0.55, ease: [0.4, 0, 0.2, 1] } },
    above: { opacity: 0, y: -y * 0.65, scale: scale + 0.004, filter: blur ? "blur(5px)" : "blur(0px)", transition: { duration: 0.55, ease: [0.4, 0, 0.2, 1] } },
  };
  return (
    <motion.div ref={ref} className={className} style={style} animate={poses[state]} initial={poses.below}>
      {children}
    </motion.div>
  );
}

/* Staggered word-by-word title */
function WordTitle({ text, className = "" }) {
  const words = text.split(" ");
  return (
    <span className={className} aria-label={text}>
      {words.map((w, i) => (
        <Reveal key={`${w}-${i}`} as="span" y={16} blur={false} amount={0.4} delay={i * 0.05} style={{ display: "inline-block" }}>
          <span aria-hidden>{w}</span>{" "}
        </Reveal>
      ))}
    </span>
  );
}

