/* --------------------------------- LOCATION ----------------------------- */
function Location() {
  const [mapOn, setMapOn] = useState(false);
  const services = [
    "Salón para 24 comensales", "Terraza pet-friendly para 16 personas", "Wi-Fi de alta velocidad",
    "Enchufes para laptops", "Baño adaptado", "Bebedero para mascotas",
    "Estacionamiento de bicis con candados de cortesía", "Rampa a nivel de banqueta y sanitario accesible",
  ];
  return (
    <section id="visitanos" className="section location">
      <div className="container">
        <SectionHead eyebrow="Ubicación y horarios" title="Una pausa tibia en el corazón de Condesa." />
        <div className="loc-grid">
          <Reveal y={26} className="loc-map">
            <div className={`map-paper ${mapOn ? "open" : ""}`}>
              {mapOn ? (
                <iframe title="Mapa de Masa & Trigo en Condesa" src={MAPS_EMBED} loading="lazy" referrerPolicy="no-referrer-when-downgrade" allowFullScreen />
              ) : (
                <button className="map-placeholder" onClick={() => setMapOn(true)}>
                  <img src={IMG.fachada} alt="Fachada de Masa & Trigo en Condesa" loading="lazy" width="900" height="600" />
                  <span className="map-cta"><Ico.pin width="18" height="18" /> Cargar mapa</span>
                </button>
              )}
            </div>
            <div className="loc-addr">
              <p><Ico.pin width="16" height="16" /> {NAP.address}</p>
              <p className="loc-ref">Esquina con Vicente Suárez, a 3 cuadras del Parque España y a 5 minutos caminando del Metro Chapultepec. Parquímetro en calle y estacionamiento público enfrente.</p>
              <div className="loc-ctas">
                <a className="btn btn-primary" href={MAPS_URL} target="_blank" rel="noopener noreferrer" onClick={() => track("click_google_maps", {})}>Abrir Google Maps</a>
                <a className="btn btn-ghost" href={`tel:${NAP.phone.replace(/\s/g, "")}`}><Ico.phone width="16" height="16" /> {NAP.phone}</a>
              </div>
            </div>
          </Reveal>
          <div className="loc-side">
            <Reveal y={20} blur={false} className="loc-hours">
              <h3><Ico.clock width="18" height="18" /> Horarios</h3>
              <ul>
                {SCHEDULE.map((s, i) => (
                  <Reveal key={s.day} as="li" y={10} blur={false} delay={i * 0.08}><span>{s.day}</span><strong>{s.hours}</strong></Reveal>
                ))}
              </ul>
              <p className="loc-bakes">Primer lote 08:00 hrs · Segundo horneado 12:30 hrs</p>
            </Reveal>
            <Reveal y={20} blur={false} delay={0.1} className="loc-services">
              <h3><Ico.leaf width="18" height="18" /> Servicios del local</h3>
              <ul className="loc-services-list">
                {services.map((s) => (<li key={s}>{s}</li>))}
              </ul>
            </Reveal>
            <svg className="loc-route" viewBox="0 0 400 90" preserveAspectRatio="none" aria-hidden>
              <motion.path d="M20 70 C 90 30, 160 75, 230 40 S 340 20, 385 45" fill="none" stroke="var(--wheat)" strokeWidth="1.4" strokeDasharray="5 5"
                initial={{ pathLength: 0 }} whileInView={{ pathLength: 1 }} viewport={{ once: false, amount: 0.5 }} transition={{ duration: 1.5 }} />
              <circle cx="20" cy="70" r="4" fill="var(--olive)" />
            </svg>
            <p className="loc-route-note">Rutas de reparto desde Condesa hacia Roma, Juárez, Polanco, Chapultepec, Del Valle y Escandón.</p>
          </div>
        </div>
      </div>
    </section>
  );
}

/* ----------------------------------- FAQ -------------------------------- */
function FAQ() {
  const [openIdx, setOpenIdx] = useState(0);
  return (
    <section id="faq" className="section faq">
      <div className="container container-narrow">
        <SectionHead eyebrow="Preguntas frecuentes" title="Lo que nos preguntan en mostrador." align="center" />
        <div className="faq-list">
          {FAQS.map((f, i) => (
            <Reveal key={f.q} y={14} blur={false} delay={i * 0.05} className="faq-item">
              <h3>
                <button className="faq-q" aria-expanded={openIdx === i} aria-controls={`faq-p-${i}`} onClick={() => setOpenIdx(openIdx === i ? -1 : i)}>
                  <span>{f.q}</span>
                  <motion.span className="faq-plus" animate={{ rotate: openIdx === i ? 45 : 0 }} transition={{ duration: 0.3 }} aria-hidden>+</motion.span>
                </button>
              </h3>
              <AnimatePresence initial={false}>
                {openIdx === i && (
                  <motion.div id={`faq-p-${i}`} role="region" initial={{ height: 0, opacity: 0 }} animate={{ height: "auto", opacity: 1 }} exit={{ height: 0, opacity: 0 }} transition={{ duration: 0.4, ease: [0.22, 1, 0.36, 1] }}>
                    <p className="faq-a">{f.a}</p>
                  </motion.div>
                )}
              </AnimatePresence>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  );
}

