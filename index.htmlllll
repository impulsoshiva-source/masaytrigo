  leaf: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden {...p}><path d="M11 20A7 7 0 0 1 4 13c0-5 4-9 9-9 4 0 7 3 7 7 0 5-4 9-9 9Z" /><path d="M4 21c4-6 8-9 12-11" /></svg>),
  bag: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden {...p}><path d="M6 8h12l1 13H5L6 8Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg>),
  bike: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden {...p}><circle cx="6" cy="17" r="3.5" /><circle cx="18" cy="17" r="3.5" /><path d="M6 17 9 8h6l3 9" /><path d="M9 8 12 17h-6" /><path d="M14 6h2l1 2" /></svg>),
  star: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.4" strokeLinejoin="round" aria-hidden {...p}><path d="m12 3 2.6 5.6 6 .7-4.5 4.1 1.2 5.9L12 16.4 6.7 19.3l1.2-5.9L3.4 9.3l6-.7L12 3Z" /></svg>),
  check: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden {...p}><path d="m4 12.5 5 5L20 6.5" /></svg>),
  x: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" aria-hidden {...p}><path d="M6 6l12 12M18 6 6 18" /></svg>),
  arrow: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden {...p}><path d="M4 12h16m-6-6 6 6-6 6" /></svg>),
  pin: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden {...p}><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" /><circle cx="12" cy="10" r="2.6" /></svg>),
  phone: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden {...p}><path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" /></svg>),
  mail: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden {...p}><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>),
  wa: (p) => (<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden {...p}><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.2c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .8-.2 1.4Z" /></svg>),
  oven: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden {...p}><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18" /><path d="M8 14a4 4 0 0 1 8 0" /><circle cx="7" cy="6.5" r=".6" /><circle cx="10" cy="6.5" r=".6" /></svg>),
  ig: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" aria-hidden {...p}><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><circle cx="17" cy="7" r=".9" fill="currentColor" stroke="none" /></svg>),
  menu: (p) => (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" aria-hidden {...p}><path d="M4 7h16M4 12h16M4 17h16" /></svg>),
};

/* --------------------------- WEBGL HERO SCENE --------------------------- */
function FlourPoints({ count = 380 }) {
  const ref = useRef(null);
  const { positions, speeds, drift } = useMemo(() => {
    const positions = new Float32Array(count * 3);
    const speeds = new Float32Array(count);
    const drift = new Float32Array(count);
    for (let i = 0; i < count; i += 1) {
      positions[i * 3] = (Math.random() - 0.5) * 15;
      positions[i * 3 + 1] = (Math.random() - 0.5) * 9;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 4;
      speeds[i] = 0.06 + Math.random() * 0.2;
      drift[i] = (Math.random() - 0.5) * 0.25;
    }
    return { positions, speeds, drift };
  }, [count]);
  useFrame((state, delta) => {
    const geo = ref.current?.geometry;
    if (!geo) return;
    const pos = geo.attributes.position;
    const t = state.clock.elapsedTime;
    for (let i = 0; i < count; i += 1) {
      let yPos = pos.getY(i) + speeds[i] * delta;
      const xPos = pos.getX(i) + Math.sin(t * 0.35 + i) * 0.0009 + drift[i] * delta * 0.15;
      if (yPos > 4.6) yPos = -4.6;
      pos.setY(i, yPos); pos.setX(i, xPos);
    }
    pos.needsUpdate = true;
    if (ref.current) ref.current.rotation.y = Math.sin(t * 0.05) * 0.04 + state.pointer.x * 0.05;
  });
  return (
    <points ref={ref} frustumCulled={false}>
      <bufferGeometry>
        <bufferAttribute attach="attributes-position" args={[positions, 3]} />
      </bufferGeometry>
      <pointsMaterial size={0.045} color="#E9CFA0" transparent opacity={0.5} sizeAttenuation depthWrite={false} blending={THREE.AdditiveBlending} />
    </points>
  );
}
function WheatFurrows() {
  const group = useRef(null);
  const curves = useMemo(() => {
    const arr = [];
    for (let c = 0; c < 3; c += 1) {
      const pts = [];
      const off = c * 0.9 - 0.9;
      for (let i = 0; i <= 40; i += 1) {
        const t = i / 40;
        pts.push([0.6 + t * 5.2, Math.sin(t * Math.PI * 1.2 + c) * 0.9 + off - t * 1.1, -1 - c * 0.3]);
      }
      arr.push(pts);
    }
    return arr;
  }, []);
  useFrame((state) => {
    const t = state.clock.elapsedTime;
    if (group.current) {
      group.current.position.y = Math.sin(t * 0.3) * 0.12;
      group.current.rotation.z = Math.sin(t * 0.12) * 0.02;
    }
  });
  return (
    <group ref={group} position={[0.4, 0.2, 0]}>
      {curves.map((pts, i) => (
        <Line key={i} points={pts} color="#D8A45F" lineWidth={1} transparent opacity={0.34 - i * 0.08} />
      ))}
    </group>
  );
}
function HeatWaves() {
  const refs = useRef([]);
  const waves = useMemo(() => [0, 1, 2].map((i) => {
    const pts = [];
    for (let k = 0; k <= 32; k += 1) {
      const t = k / 32;
      pts.push([Math.sin(t * Math.PI * 3 + i) * 0.35, t * 1.8 - 0.9, 0]);
    }
    return pts;
  }), []);
  useFrame((state) => {
    refs.current.forEach((obj, i) => {
      if (!obj) return;
      const cycle = (state.clock.elapsedTime * 0.16 + i * 0.33) % 1;
      obj.position.y = cycle * 3.4 - 2.2;
      obj.material.opacity = 0.26 * Math.sin(cycle * Math.PI);
    });
  });
  return (
    <group position={[3.1, -0.3, -2]}>
      {waves.map((pts, i) => (
        <Line key={i} ref={(el) => { refs.current[i] = el; }} points={pts} color="#E8B877" lineWidth={1} transparent opacity={0.2} />
      ))}
    </group>
  );
}
function LoafOutline() {
  const ref = useRef(null);
  const pts = useMemo(() => {
    const p = [];
    for (let i = 0; i <= 60; i += 1) {
      const a = Math.PI * (i / 60);
      p.push([Math.cos(a) * 2.1, Math.sin(a) * 1.15 - 1.7, 0]);
    }
    return p;
  }, []);
  useFrame((state) => {
    const m = ref.current?.material;
    const t = state.clock.elapsedTime;
    if (m) m.dashOffset = Math.max(0, 9 - t * 2.0);
    if (ref.current) ref.current.scale.setScalar(1 + Math.sin(t * 0.8) * 0.012);
  });
  return (
    <group position={[2.6, -0.5, 0]}>
      <Line ref={ref} points={pts} color="#C98F4E" lineWidth={1.4} dashed dashSize={0.35} gapSize={0.35} />
      {[0, 1, 2].map((i) => (
        <Line key={i} points={[[1.3 + i * 0.5, -1.15 + i * 0.1, 0.01], [1.7 + i * 0.5, -0.6 + i * 0.1, 0.01]]} color="#C98F4E" lineWidth={1} transparent opacity={0.45} />
      ))}
    </group>
  );
}
function FlourHeatScene() {
  return (
    <Canvas
      dpr={[1, 1.5]}
      gl={{ alpha: true, antialias: true, powerPreference: "low-power" }}
      camera={{ position: [0, 0, 7], fov: 40 }}
      style={{ position: "absolute", inset: 0 }}
      aria-hidden
    >
      <FlourPoints count={380} />
      <WheatFurrows />
      <HeatWaves />
      <LoafOutline />
    </Canvas>
  );
}

/* ------------------------------ SMALL PARTS ----------------------------- */
function WheatSeal({ size = 54, className = "" }) {
  return (
    <span className={`seal ${className}`} style={{ width: size, height: size }} aria-hidden>
      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" strokeWidth="1.4">
        <circle cx="32" cy="32" r="30" strokeDasharray="3 4" />
        <circle cx="32" cy="32" r="24" />
        <path d="M32 46V22" strokeLinecap="round" />
        <path d="M32 26c-4 0-6.5-3-6.5-6.5 4 0 6.5 3 6.5 6.5ZM32 26c4 0 6.5-3 6.5-6.5-4 0-6.5 3-6.5 6.5Z" />
        <path d="M32 34c-4 0-6.5-3-6.5-6.5 4 0 6.5 3 6.5 6.5ZM32 34c4 0 6.5-3 6.5-6.5-4 0-6.5 3-6.5 6.5Z" />
        <path d="M32 42c-4 0-6.5-3-6.5-6.5 4 0 6.5 3 6.5 6.5ZM32 42c4 0 6.5-3 6.5-6.5-4 0-6.5 3-6.5 6.5Z" />
      </svg>
    </span>
  );
}
function Stars({ n = 5 }) {
  return (
    <span className="stars" role="img" aria-label={`${n} estrellas`}>
      {Array.from({ length: n }).map((_, i) => (
        <motion.span key={i} initial={{ opacity: 0, scale: 0.6 }} whileInView={{ opacity: 1, scale: 1 }} viewport={{ once: false, amount: 0.6 }} transition={{ delay: i * 0.09, duration: 0.4 }}>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" strokeWidth="1.3" strokeLinejoin="round" aria-hidden>
            <motion.path d="m12 3 2.6 5.6 6 .7-4.5 4.1 1.2 5.9L12 16.4 6.7 19.3l1.2-5.9L3.4 9.3l6-.7L12 3Z" initial={{ pathLength: 0 }} whileInView={{ pathLength: 1 }} viewport={{ once: false, amount: 0.6 }} transition={{ delay: i * 0.09, duration: 0.6 }} />
          </svg>
        </motion.span>
      ))}
    </span>
  );
}
function AllergenChips({ list }) {
  if (!list?.length) return <span className="chip chip-ok">Sin alérgenos principales</span>;
  return (
    <span className="allergens">
      {list.map((a) => (<span key={a} className="chip">{a}</span>))}
    </span>
  );
}
function SectionHead({ eyebrow, title, lead, align = "left", dark = false }) {
  return (
    <header className={`sec-head ${align === "center" ? "center" : ""} ${dark ? "dark" : ""}`}>
      {eyebrow && <Reveal y={14} blur={false}><p className="eyebrow">{eyebrow}</p></Reveal>}
      <Reveal y={26}><h2 className="h2">{title}</h2></Reveal>
      {lead && <Reveal y={18} blur={false} delay={0.08}><p className="lead">{lead}</p></Reveal>}
    </header>
  );
}

/* -------------------------------- STATUS BAR ---------------------------- */
function useBakeryStatus() {
  const [now, setNow] = useState(() => new Date());
  useEffect(() => {
    const id = setInterval(() => setNow(new Date()), 60000);
    return () => clearInterval(id);
  }, []);
  const day = now.getDay();
  const mins = now.getHours() * 60 + now.getMinutes();
  if (day === 1) return { open: false, main: "Hoy el obrador descansa para preparar la próxima hornada", sub: "Martes volvemos con el primer lote a las 08:00 hrs" };
  const [openM, closeM] = day === 0 ? [510, 1020] : [450, 1230];
  const open = mins >= openM && mins < closeM;
  let sub = "";
  if (open) sub = mins < 480 ? "Primer lote de hogazas y croissants: 08:00 hrs" : mins < 750 ? "Segundo horneado de baguettes y focaccias: 12:30 hrs" : "Vitrina disponible hasta agotar la producción diaria";
  else sub = mins < openM ? "Abrimos más tarde hoy · primer lote 08:00 hrs" : "Horneamos de nuevo mañana desde las 07:30 hrs";
  return { open, main: open ? "Horneando hoy · Abierto de 7:30 a 20:30 hrs" : "Cerrado en este momento", sub };
}
function StatusBar() {
  const s = useBakeryStatus();
  return (
    <div className="statusbar" role="status">
      <span className={`dot ${s.open ? "on" : "off"}`} aria-hidden />
      <strong>{s.main}</strong>
      <span className="status-sub"> · {s.sub}</span>
      <a href="#menu" className="status-link">Ver menú del día</a>
    </div>
  );
}

/* --------------------------------- HEADER ------------------------------- */
const NAV = [
  { label: "Pan del día", href: "#menu", tab: "masa-madre" },
  { label: "Masa madre", href: "#historia" },
  { label: "Pastelería", href: "#menu", tab: "pasteleria" },
  { label: "Pedidos especiales", href: "#pasteles" },
  { label: "Café", href: "#menu", tab: "cafe" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Visítanos", href: "#visitanos" },
];
function Header({ setMenuTab }) {
  const [solid, setSolid] = useState(false);
  const [openMobile, setOpenMobile] = useState(false);
  const { scrollY } = useScroll();
  useMotionValueEvent(scrollY, "change", (v) => setSolid(v > 48));
  const go = (e, item) => {
    if (item.tab) { setMenuTab(item.tab); }
    setOpenMobile(false);
  };
  return (
    <header className={`hdr ${solid ? "solid" : ""}`}>
      <div className="hdr-in">
        <a className="logo" href="#inicio" aria-label="Masa & Trigo — inicio">
          <WheatSeal size={38} />
          <span className="logo-txt">Masa <em>&</em> Trigo<span className="logo-sub">Panadería rústica · Condesa</span></span>
        </a>
        <nav className="nav" aria-label="Navegación principal">
          {NAV.map((n) => (
            <a key={n.label} href={n.href} onClick={(e) => go(e, n)}>{n.label}</a>
          ))}
        </nav>
        <div className="hdr-cta">
          <a className="btn btn-primary btn-sm" href={TIENDANUBE_URL} target="_blank" rel="noopener noreferrer"
            onClick={() => track("click_order_hero", { from: "header" })}>
            Ordena tu Pan en Línea
          </a>
          <button className="icon-btn burger" aria-label="Abrir menú" aria-expanded={openMobile} onClick={() => setOpenMobile((v) => !v)}>
            {openMobile ? <Ico.x width="22" height="22" /> : <Ico.menu width="22" height="22" />}
          </button>
        </div>
      </div>
      <AnimatePresence>
        {openMobile && (
          <motion.nav className="mobile-nav" initial={{ opacity: 0, y: -12 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -12 }} transition={{ duration: 0.3 }} aria-label="Menú móvil">
            {NAV.map((n, i) => (
              <motion.a key={n.label} href={n.href} initial={{ opacity: 0, x: -14 }} animate={{ opacity: 1, x: 0 }} transition={{ delay: 0.05 * i }} onClick={(e) => go(e, n)}>{n.label}</motion.a>
            ))}
            <a className="btn btn-primary" href={TIENDANUBE_URL} target="_blank" rel="noopener noreferrer" onClick={() => track("click_order_hero", { from: "mobile_menu" })}>Ordena tu Pan en Línea</a>
          </motion.nav>
        )}
      </AnimatePresence>
    </header>
  );
}

/* ---------------------------------- HERO -------------------------------- */
function Hero() {
  const reduced = useReducedMotion();
  const [showCanvas, setShowCanvas] = useState(false);
  const wrapRef = useRef(null);
  const { scrollYProgress } = useScroll({ target: wrapRef, offset: ["start start", "end start"] });
  const fade = useTransform(scrollYProgress, [0, 0.85], [1, 0]);
  const lift = useTransform(scrollYProgress, [0, 1], [0, -60]);

  useEffect(() => {
    if (typeof window === "undefined") return undefined;
    const mqReduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = window.matchMedia("(pointer: fine)").matches;
    const saveData = !!navigator.connection?.saveData;
    const mem = navigator.deviceMemory ?? 8;
    const wide = window.innerWidth >= 900;
    if (mqReduce || !fine || saveData || mem < 4 || !wide) return undefined;
    const id = window.setTimeout(() => setShowCanvas(true), 450);
    return () => window.clearTimeout(id);
  }, []);

  const lines = ["El tiempo perfecto", "hace al pan", "honesto."];
  return (
    <section id="inicio" className="hero" ref={wrapRef}>
      <div className="hero-media" aria-hidden>
        <img src={IMG.hero} alt="" fetchPriority="high" />
        <div className="hero-scrim" />
      </div>
      {showCanvas && !reduced && (
        <div className="hero-canvas" aria-hidden>
          <Suspense fallback={null}><FlourHeatScene /></Suspense>
        </div>
      )}
      <motion.div className="hero-in" style={{ opacity: fade, y: lift }}>
        <div className="hero-copy">
          <motion.p className="eyebrow" initial={{ opacity: 0, y: 12 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.7, delay: 0.15 }}>
            Panadería artesanal · Condesa, CDMX
          </motion.p>
          <h1 className="h1">
            {lines.map((ln, i) => (
              <span className="h1-line" key={ln}>
                <motion.span initial={{ y: "112%", filter: "blur(6px)" }} animate={{ y: "0%", filter: "blur(0px)" }} transition={{ duration: 1.0, delay: 0.25 + i * 0.12, ease: [0.22, 1, 0.36, 1] }}>
                  {ln}
                </motion.span>
              </span>
            ))}
          </h1>
          <motion.p className="hero-lead" initial={{ opacity: 0, y: 14 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.8, delay: 0.7 }}>
            Hogazas de masa madre de fermentación lenta, bollería laminada con mantequilla auténtica, pastelería de autor y café de especialidad para acompañar tus días sin prisa.
          </motion.p>
          <motion.div className="hero-ctas" initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.8, delay: 0.85 }}>
            <a className="btn btn-primary btn-lg" href={TIENDANUBE_URL} target="_blank" rel="noopener noreferrer" data-cursor="cta"
              onClick={() => track("click_order_hero", { from: "hero" })}>
              Ordena tu Pan en Línea <Ico.arrow width="18" height="18" />
            </a>
            <a className="btn btn-ghost btn-lg" href="#menu" onClick={() => track("click_order_menu", { from: "hero" })}>Ver Menú del Día</a>
          </motion.div>
          <ul className="hero-trust">
            {["Masa madre viva desde 2020", "Fermentación lenta de 36 horas", "Horneado diario"].map((t, i) => (
              <motion.li key={t} initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 1.0 + i * 0.08, duration: 0.6 }}>
                <Ico.wheat width="15" height="15" /> {t}
              </motion.li>
            ))}
          </ul>
        </div>
      </motion.div>
      <div className="hero-scroll-hint" aria-hidden>
        <motion.span animate={{ y: [0, 7, 0] }} transition={{ duration: 2.4, repeat: reduced ? 0 : Infinity, ease: "easeInOut" }} />
      </div>
    </section>
  );
}

/* ------------------------------- CRAFT PROOF ---------------------------- */
function CraftProof() {
  const proofs = [
    { big: "36", unit: "horas", label: "de fermentación lenta" },
    { big: "2020", unit: "", label: "masa madre viva cultivada" },
    { big: "100%", unit: "", label: "harinas agroecológicas mexicanas sin conservadores" },
  ];
  const awards = [
    "Reconocimiento Guía de Panaderías Artesanales CDMX 2024",
    "Finalistas Festival del Pan de Muerto Artesanal 2024",
  ];
  return (
    <section id="oficio" className="section craft">
      <div className="container">
        <SectionHead eyebrow="Prueba de oficio" title="El método no se apura." lead="Cada sello es una promesa que se hornea todos los días." />
        <div className="craft-grid">
          {proofs.map((p, i) => (
            <Reveal key={p.label} delay={i * 0.1} className="craft-card">
              <WheatSeal size={64} className="craft-seal" />
              <p className="craft-big">
                <CountUp value={p.big} />{p.unit && <span className="craft-unit"> {p.unit}</span>}
              </p>
              <p className="craft-label">{p.label}</p>
            </Reveal>
          ))}
        </div>
        <div className="craft-awards">
          {awards.map((a, i) => (
            <Reveal key={a} delay={0.15 + i * 0.1} y={16} blur={false} className="award">
              <Ico.star width="16" height="16" /> {a}
            </Reveal>
          ))}
        </div>
        <svg className="craft-line" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden>
          <motion.path d="M0 40 C 200 10, 400 55, 600 30 S 1000 12, 1200 38" fill="none" stroke="var(--wheat)" strokeWidth="1.4"
            initial={{ pathLength: 0 }} whileInView={{ pathLength: 1 }} viewport={{ once: false, amount: 0.5 }} transition={{ duration: 1.6, ease: "easeInOut" }} />
        </svg>
      </div>
    </section>
  );
}
function CountUp({ value }) {
  const num = parseInt(value, 10);
  const ref = useRef(null);
  const inView = useInView(ref, { once: false, amount: 0.6 });
  const reduced = useReducedMotion();
  const [display, setDisplay] = useState(reduced || Number.isNaN(num) ? value : "0");
  useEffect(() => {
    if (Number.isNaN(num)) { setDisplay(value); return; }
    if (!inView) { setDisplay(reduced ? String(num) : "0"); return; }
    if (reduced) { setDisplay(String(num)); return; }
    let raf; const t0 = performance.now(); const dur = 1200;
    const step = (t) => {
      const k = Math.min(1, (t - t0) / dur);
      setDisplay(String(Math.round(num * (1 - Math.pow(1 - k, 3)))));
      if (k < 1) raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
    return () => cancelAnimationFrame(raf);
  }, [inView, num, value, reduced]);
  return <span ref={ref}>{display}</span>;
}

/* ------------------------------ STORY OF DOUGH -------------------------- */
function StoryOfDough() {
  const steps = ["Mezclar", "Reposar", "Fermentar", "Hornear"];
  const photos = [
    { src: IMG.harina, alt: "Harina agroecológica espolvoreada sobre la masa" },
    { src: IMG.banneton, alt: "Hogazas fermentando en cestas banneton de mimbre" },
    { src: IMG.grenado, alt: "Greñado de hogaza con navaja antes del horno" },
    { src: IMG.laminado, alt: "Laminado de mantequilla para bollería" },
  ];
  return (
    <section id="historia" className="section story">
      <div className="container">
        <div className="story-grid">
          <div className="story-text">
            <SectionHead eyebrow="La historia de la masa" title={<WordTitle text="Todo buen pan comienza con tiempo." />} />
            <Reveal y={16} blur={false} delay={0.1}>
              <p className="story-p">
                Masa & Trigo nació en 2020, cuando dos apasionados de la gastronomía decidieron devolver al pan su valor nutricional, su reposo y su sabor honesto. De un pequeño horno casero a un obrador abierto en Condesa, cada hogaza mantiene la misma idea: ingredientes elementales, técnica rigurosa y respeto por los ritmos naturales.
              </p>
            </Reveal>
            <ol className="story-timeline" aria-label="Proceso del pan">
              {steps.map((s, i) => (
                <Reveal key={s} as="li" y={12} blur={false} delay={i * 0.12} className="story-step">
                  <span className="step-dot" aria-hidden><motion.i initial={{ scale: 0 }} whileInView={{ scale: 1 }} viewport={{ once: false, amount: 0.6 }} transition={{ delay: i * 0.12 + 0.1, type: "spring", stiffness: 200, damping: 18 }} /></span>
                  <span>{s}</span>
                </Reveal>
              ))}
              <svg className="timeline-line" viewBox="0 0 400 4" preserveAspectRatio="none" aria-hidden>
                <motion.path d="M0 2 H400" stroke="var(--line)" strokeWidth="2" initial={{ pathLength: 0 }} whileInView={{ pathLength: 1 }} viewport={{ once: false, amount: 0.5 }} transition={{ duration: 1.4 }} />
              </svg>
            </ol>
          </div>
          <div className="story-photos">
            {photos.map((ph, i) => (
              <Reveal key={ph.src} delay={i * 0.08} className={`story-photo sp-${i}`} y={26}>
                <motion.div className="flour-mask" initial={{ clipPath: "inset(0 0 0 0)" }} whileInView={{ clipPath: "inset(0 0 100% 0)" }} viewport={{ once: false, amount: 0.4 }} transition={{ duration: 1.1, delay: i * 0.08, ease: [0.22, 1, 0.36, 1] }} aria-hidden />
                <img src={ph.src} alt={ph.alt} loading="lazy" width="600" height="600" />
              </Reveal>
            ))}
          </div>
        </div>
      </div>
    </section>
  );
}

/* ------------------------------- DIGITAL MENU --------------------------- */
function DigitalMenu({ tab, setTab }) {
  const active = MENU_CATEGORIES.find((c) => c.id === tab) || MENU_CATEGORIES[0];
  return (
    <section id="menu" className="section menu-sec">
      <div className="container">
        <SectionHead eyebrow="Menú digital y vitrina" title="Lo que sale del horno hoy." lead="Precios transparentes, alérgenos etiquetados y disponibilidad sujeta al horneado diario." />
        <div className="tabs" role="tablist" aria-label="Categorías del menú">
          {MENU_CATEGORIES.map((c) => (
            <button key={c.id} role="tab" id={`tab-${c.id}`} aria-selected={tab === c.id} aria-controls={`panel-${c.id}`}
              className={`tab ${tab === c.id ? "on" : ""}`} onClick={() => { setTab(c.id); track("menu_category_selected", { category: c.id }); }}>
              {c.label}
              {tab === c.id && <motion.span layoutId="wheat-trail" className="tab-trail" transition={{ type: "spring", stiffness: 320, damping: 32 }} />}
            </button>
          ))}
        </div>
        <p className="tab-note" id={`panel-${active.id}`} role="tabpanel" aria-labelledby={`tab-${active.id}`}>
          <AnimatePresence mode="wait">
            <motion.span key={active.id} initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -8 }} transition={{ duration: 0.35 }}>
              {active.note}
            </motion.span>
          </AnimatePresence>
        </p>
        <motion.div layout className="menu-grid" key={active.id}>
          {active.items.map((p, i) => (
            <motion.article layout key={p.name} className="pcard"
              initial={{ opacity: 0, y: 18, filter: "blur(5px)" }}
              animate={{ opacity: 1, y: 0, filter: "blur(0px)" }}
              exit={{ opacity: 0, y: -12, filter: "blur(4px)" }}
              transition={{ duration: 0.55, delay: i * 0.06, ease: [0.22, 1, 0.36, 1] }}>
              {p.img ? (
                <div className="pcard-media" data-cursor="view">
                  <img src={p.img} alt={p.name} loading="lazy" width="640" height="480" />
                </div>
              ) : (
                <div className="pcard-media pcard-media-plain" aria-hidden><WheatSeal size={56} /></div>
              )}
              <div className="pcard-body">
                <div className="pcard-top">
                  <h3>{p.name}</h3>
                  <span className="price"><CountUp value={String(p.price)} prefix="$" />{p.priceLabel && <em>{p.priceLabel.replace(/^\$\d+/, "") ? "" : ""}</em>}</span>
                </div>
                <p className="pcard-price">{p.priceLabel} MXN</p>
                <p className="pcard-desc">{p.desc}</p>
                <p className="pcard-ing"><strong>Ingredientes:</strong> {p.ing}</p>
                <AllergenChips list={p.allergens} />
                {p.note && <p className="pcard-note"><Ico.clock width="13" height="13" /> {p.note}</p>}
                <a className="btn btn-ghost btn-sm pcard-cta" href={TIENDANUBE_URL} target="_blank" rel="noopener noreferrer"
                  onClick={() => track("click_order_menu", { product: p.name })}>Ordenar en línea</a>
              </div>
            </motion.article>
          ))}
        </motion.div>
      </div>
    </section>
  );
}

/* ---------------------------- FEATURED PRODUCTS ------------------------- */
function FeaturedProducts() {
  const feats = [
    { img: IMG.croissant, name: "Croissant de mantequilla hojaldrado", note: "Capas que crujen, mantequilla que perfuma la mañana.", hours: "72 h de laminado en frío", effect: "layers" },
    { img: IMG.hogaza, name: "Hogaza Rústica de Masa Madre 800 g", note: "36 horas de paciencia para una miga viva y una corteza que canta al partirse.", hours: "36 h de fermentación", effect: "score" },
    { img: IMG.basque, name: "Basque Burnt Cheesecake", note: "Cremoso al centro, tostado en los bordes, equilibrado hasta la última cucharada.", hours: "Horneado único a alta temperatura", effect: "halo" },
  ];
  return (
    <section id="estrella" className="section featured">
      <div className="container">
        <SectionHead eyebrow="Productos estrella" title="Los tres que definen la casa." align="center" />
        <div className="feat-grid">
          {feats.map((f, i) => (
            <Reveal key={f.name} delay={i * 0.12} className="feat-card">
              <div className="feat-vitrine" aria-hidden>
                <motion.span className="vitrine-glass" initial={{ x: "-102%" }} whileInView={{ x: "0%" }} viewport={{ once: false, amount: 0.4 }} transition={{ duration: 1.1, delay: i * 0.12, ease: [0.22, 1, 0.36, 1] }} />
              </div>
              <div className="feat-media" data-cursor="view">
                <img src={f.img} alt={f.name} loading="lazy" width="700" height="700" />
                {f.effect === "score" && (
                  <svg className="feat-fx" viewBox="0 0 100 100" aria-hidden>
                    {[0, 1, 2, 3].map((k) => (
                      <motion.path key={k} d={`M${28 + k * 12} 62 Q ${34 + k * 12} 46 ${30 + k * 12} 34`} stroke="var(--wheat)" strokeWidth="1.2" fill="none"
                        initial={{ pathLength: 0, opacity: 0 }} whileInView={{ pathLength: 1, opacity: 0.85 }} viewport={{ once: false, amount: 0.5 }} transition={{ duration: 0.9, delay: 0.3 + k * 0.12 }} />
                    ))}
                  </svg>
                )}
                {f.effect === "layers" && (
                  <svg className="feat-fx" viewBox="0 0 100 100" aria-hidden>
                    {[0, 1, 2, 3, 4].map((k) => (
                      <motion.path key={k} d={`M18 ${38 + k * 7} Q 50 ${30 + k * 7} 82 ${38 + k * 7}`} stroke="var(--wheat)" strokeWidth="1" fill="none"
                        initial={{ pathLength: 0, opacity: 0 }} whileInView={{ pathLength: 1, opacity: 0.7 }} viewport={{ once: false, amount: 0.5 }} transition={{ duration: 0.8, delay: 0.25 + k * 0.1 }} />
                    ))}
                  </svg>
                )}
                {f.effect === "halo" && (
                  <motion.span className="feat-halo" initial={{ scale: 0.4, opacity: 0 }} whileInView={{ scale: 1, opacity: 0.55 }} viewport={{ once: false, amount: 0.5 }} transition={{ duration: 1.2 }} aria-hidden />
                )}
              </div>
              <h3 className="feat-name">{f.name}</h3>
              <p className="feat-note">“{f.note}”</p>
              <p className="feat-hours"><Ico.clock width="14" height="14" /> {f.hours}</p>
              <a className="btn btn-primary btn-sm" href={TIENDANUBE_URL} target="_blank" rel="noopener noreferrer"
                onClick={() => track("click_order_menu", { product: f.name, from: "featured" })}>Pedir ahora</a>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  );
}

/* ------------------------------ SEASONAL SPECIAL ------------------------ */
function SeasonalSpecial() {
  const seasonals = [
    { window: "Septiembre – noviembre", name: "Pan de Muerto de masa madre", desc: "Agua de azahar, naranja natural y fermentación lenta.", img: IMG.panmuerto, stamp: "SEP–NOV" },
    { window: "Diciembre – enero", name: "Rosca de Reyes artesanal", desc: "Mantequilla pura, costra crujiente y frutas confitadas en casa.", img: null, stamp: "DIC–ENE" },
    { window: "Febrero", name: "Cruffins de chocolate ruby y frambuesa", desc: "Hojaldre en espiral con notas ácidas y florales.", img: null, stamp: "FEB" },
  ];
  return (
    <section id="temporada" className="section seasonal">
      <div className="container">
        <SectionHead eyebrow="Especial de la semana y temporadas" title="El calendario también se hornea." lead="Disponible hasta agotar la producción diaria." />
        <div className="season-grid">
          {seasonals.map((s, i) => (
            <Reveal key={s.name} delay={i * 0.1} className="season-card">
              <span className="season-stamp" aria-hidden>{s.stamp}</span>
              {s.img ? (
                <div className="season-media" data-cursor="view"><img src={s.img} alt={s.name} loading="lazy" width="640" height="480" /></div>
              ) : (
                <div className="season-illo" aria-hidden>
                  <svg viewBox="0 0 120 80" fill="none" stroke="var(--wheat-deep)" strokeWidth="1.3" strokeLinecap="round">
                    <motion.path d="M20 55c0-18 18-30 40-30s40 12 40 30" initial={{ pathLength: 0 }} whileInView={{ pathLength: 1 }} viewport={{ once: false, amount: 0.5 }} transition={{ duration: 1.1, delay: 0.2 + i * 0.1 }} />
                    <motion.path d="M35 30c4-8 12-10 16-6M60 24c2-8 10-10 14-6M84 32c4-6 10-6 13-2" initial={{ pathLength: 0, opacity: 0 }} whileInView={{ pathLength: 1, opacity: 1 }} viewport={{ once: false, amount: 0.5 }} transition={{ duration: 0.8, delay: 0.6 + i * 0.1 }} />
                    <motion.circle cx="45" cy="45" r="3" initial={{ scale: 0 }} whileInView={{ scale: 1 }} viewport={{ once: false, amount: 0.5 }} transition={{ delay: 0.9 }} />
                    <motion.circle cx="70" cy="42" r="3" initial={{ scale: 0 }} whileInView={{ scale: 1 }} viewport={{ once: false, amount: 0.5 }} transition={{ delay: 1.0 }} />
                  </svg>
                </div>
              )}
              <p className="season-window">{s.window}</p>
              <h3>{s.name}</h3>
              <p className="season-desc">{s.desc}</p>
              <a className="link-wheat" href={TIENDANUBE_URL} target="_blank" rel="noopener noreferrer" onClick={() => track("click_tiendanube", { from: "seasonal", item: s.name })}>
                Ver especial <Ico.arrow width="14" height="14" />
              </a>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  );
}

/* ---------------------------- CELEBRATION CAKES ------------------------- */
const EMPTY_FORM = { name: "", phone: "", email: "", eventType: "", date: "", guests: "", style: "" };
function CelebrationCakes() {
  const [form, setForm] = useState(EMPTY_FORM);
  const [errors, setErrors] = useState({});
  const [sent, setSent] = useState(false);
  const set = (k) => (e) => { setForm((f) => ({ ...f, [k]: e.target.value })); setErrors((er) => ({ ...er, [k]: undefined })); };
  const validate = () => {
    const er = {};
    if (!form.name.trim()) er.name = "Escribe tu nombre completo.";
    if (!/^[+\d][\d\s-]{7,}$/.test(form.phone.trim())) er.phone = "Ingresa un WhatsApp o teléfono válido.";
    if (!/^\S+@\S+\.\S+$/.test(form.email.trim())) er.email = "Ingresa un correo válido.";
    if (!form.eventType) er.eventType = "Selecciona el tipo de evento.";
    if (!form.date) er.date = "Indica la fecha requerida.";
    return er;
  };
  const submit = (e) => {
    e.preventDefault();
    track("cake_form_submit", {});
    const er = validate();
    if (Object.keys(er).length) { setErrors(er); return; }
    setSent(true);
  };
  const startTrack = () => track("cake_form_start", {});
  return (
    <section id="pasteles" className="section cakes">
      <div className="container">
        <div className="kraft-ribbon" aria-hidden>
          <motion.span initial={{ scaleX: 0 }} whileInView={{ scaleX: 1 }} viewport={{ once: false, amount: 0.3 }} transition={{ duration: 1.4, ease: [0.22, 1, 0.36, 1] }} style={{ transformOrigin: "left center" }} />
        </div>
        <SectionHead eyebrow="Pasteles de celebración y eventos" title="Hechos para celebrar lo que importa." lead="Pasteles personalizados, mesas de postres rústicas y cajas surtidas para 20 a 150 personas. Sin fondant: solo texturas naturales." />
        <div className="cakes-grid">
          <div className="cakes-info">
            <ul className="cakes-list">
              {[
                "Naked cake, flores orgánicas comestibles y texturas en buttercream o ganache.",
                "Pasteles estándar: 24 horas de anticipación.",
                "Personalizados o bodas: 5 a 7 días.",
                "Mesas de postres y catering: 10 días hábiles.",
                "Anticipo 50% en pedidos grandes; liquidación 48 horas antes.",
                "Cancelación sin penalización con 4 días de anticipación.",
              ].map((t, i) => (
                <Reveal key={t} as="li" y={12} blur={false} delay={i * 0.07} className="cakes-item">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="var(--olive)" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden>
                    <motion.path d="m4 12.5 5 5L20 6.5" initial={{ pathLength: 0 }} whileInView={{ pathLength: 1 }} viewport={{ once: false, amount: 0.6 }} transition={{ duration: 0.5, delay: i * 0.07 + 0.15 }} />
                  </svg>
                  <span>{t}</span>
                </Reveal>
              ))}
            </ul>
            <Reveal y={16} blur={false} className="cakes-photos">
              <img src={IMG.tarta} alt="Tarta rústica con flores comestibles" loading="lazy" width="520" height="520" />
              <img src={IMG.paulina} alt="Chef pastelera decorando una tarta con flores" loading="lazy" width="520" height="520" />
            </Reveal>
          </div>
          <Reveal y={26} className="cakes-form-wrap">
            {sent ? (
              <div className="form-success" role="status">
                <WheatSeal size={56} />
                <h3>¡Gracias, {form.name.split(" ")[0]}!</h3>
                <p>Recibimos tu solicitud de cotización. Te responderemos por WhatsApp o correo en menos de 24 horas hábiles.</p>
                <a className="btn btn-primary" href={WA_LINK} target="_blank" rel="noopener noreferrer" onClick={() => track("click_whatsapp_order", { from: "cake_success" })}>
                  <Ico.wa width="17" height="17" /> Continuar por WhatsApp
                </a>
              </div>
            ) : (
              <form className="cake-form" onSubmit={submit} onFocus={startTrack} noValidate>
                <h3 className="form-title">Cotiza tu celebración</h3>
                <div className="field"><label htmlFor="ck-name">Nombre completo *</label>
                  <input id="ck-name" value={form.name} onChange={set("name")} aria-invalid={!!errors.name} aria-describedby={errors.name ? "ck-name-err" : undefined} />
                  {errors.name && <p className="err" id="ck-name-err" role="alert">{errors.name}</p>}
                </div>
                <div className="field-row">
                  <div className="field"><label htmlFor="ck-phone">WhatsApp / teléfono *</label>
                    <input id="ck-phone" type="tel" value={form.phone} onChange={set("phone")} aria-invalid={!!errors.phone} aria-describedby={errors.phone ? "ck-phone-err" : undefined} />
                    {errors.phone && <p className="err" id="ck-phone-err" role="alert">{errors.phone}</p>}
                  </div>
                  <div className="field"><label htmlFor="ck-email">Correo *</label>
                    <input id="ck-email" type="email" value={form.email} onChange={set("email")} aria-invalid={!!errors.email} aria-describedby={errors.email ? "ck-email-err" : undefined} />
                    {errors.email && <p className="err" id="ck-email-err" role="alert">{errors.email}</p>}
                  </div>
                </div>
                <div className="field-row">
                  <div className="field"><label htmlFor="ck-type">Tipo de evento *</label>
                    <select id="ck-type" value={form.eventType} onChange={set("eventType")} aria-invalid={!!errors.eventType}>
                      <option value="">Selecciona…</option>
                      <option>Cumpleaños</option><option>Aniversario</option><option>Boda íntima</option>
                      <option>Evento corporativo</option><option>Mesa de postres</option><option>Otro</option>
                    </select>
                    {errors.eventType && <p className="err" role="alert">{errors.eventType}</p>}
                  </div>
                  <div className="field"><label htmlFor="ck-date">Fecha requerida *</label>
                    <input id="ck-date" type="date" value={form.date} onChange={set("date")} aria-invalid={!!errors.date} />
                    {errors.date && <p className="err" role="alert">{errors.date}</p>}
                  </div>
                </div>
                <div className="field-row">
                  <div className="field"><label htmlFor="ck-guests">Comensales aproximados</label>
                    <input id="ck-guests" type="number" min="1" max="150" value={form.guests} onChange={set("guests")} placeholder="20 – 150" />
                  </div>
                  <div className="field"><label htmlFor="ck-style">Estilo o producto de interés</label>
                    <input id="ck-style" value={form.style} onChange={set("style")} placeholder="Naked cake, flores naturales…" />
                  </div>
                </div>
                <button className="btn btn-primary btn-lg" type="submit" data-cursor="cta" onClick={() => track("click_custom_cake_quote", {})}>
                  Cotizar mi celebración
                </button>
                <p className="form-fine">Al enviar aceptas nuestro aviso de privacidad. Nunca compartimos tus datos.</p>
              </form>
            )}
          </Reveal>
        </div>
      </div>
    </section>
  );
}

/* ---------------------------- DELIVERY & PICKUP ------------------------- */
function DeliveryPickup() {
  return (
    <section id="entrega" className="section delivery">
      <div className="container">
        <SectionHead eyebrow="Click & Collect y entrega" title="Del horno a tus manos, como prefieras." align="center" />
        <div className="delivery-wrap">
          <svg className="delivery-paths" viewBox="0 0 800 120" preserveAspectRatio="none" aria-hidden>
            <motion.path d="M400 20 C 300 40, 220 60, 140 95" fill="none" stroke="var(--wheat)" strokeWidth="1.6" strokeDasharray="6 6"
              initial={{ pathLength: 0 }} whileInView={{ pathLength: 1 }} viewport={{ once: false, amount: 0.5 }} transition={{ duration: 1.2 }} />
            <motion.path d="M400 20 C 500 40, 580 60, 660 95" fill="none" stroke="var(--olive)" strokeWidth="1.6" strokeDasharray="6 6"
              initial={{ pathLength: 0 }} whileInView={{ pathLength: 1 }} viewport={{ once: false, amount: 0.5 }} transition={{ duration: 1.2, delay: 0.15 }} />
            <circle cx="400" cy="18" r="6" fill="var(--wheat)" />
          </svg>
          <div className="delivery-grid">
            <Reveal y={26} className="delivery-card">
              <motion.span className="d-ico" initial={{ y: 0 }} whileInView={{ y: -6 }} viewport={{ once: false, amount: 0.6 }} transition={{ duration: 0.6, yoyo: false }}>
                <Ico.bag width="26" height="26" />
              </motion.span>
              <h3>Click & Collect</h3>
              <ul>
                <li>Recoge en mostrador sin hacer fila una vez confirmado el pedido.</li>
                <li>Pan y galletas: 3 a 4 horas de anticipación o mismo día según disponibilidad.</li>
                <li>Pasteles de catálogo: 24 horas.</li>
              </ul>
              <a className="btn btn-ghost" href={TIENDANUBE_URL} target="_blank" rel="noopener noreferrer" onClick={() => track("click_click_collect", {})}>Elegir recogida</a>
            </Reveal>
            <Reveal y={26} delay={0.12} className="delivery-card">
              <motion.span className="d-ico" initial={{ y: 0 }} whileInView={{ y: -6 }} viewport={{ once: false, amount: 0.6 }} transition={{ duration: 0.6, delay: 0.1 }}>
                <Ico.bike width="26" height="26" />
              </motion.span>
              <h3>Entrega a domicilio</h3>
              <ul>
                <li>Reparto en bicicleta y auto climatizado.</li>
                <li>Cobertura: Condesa, Roma Nte/Sur, Juárez, Cuauhtémoc, Polanco, San Miguel Chapultepec, Del Valle Norte y Escandón.</li>
                <li>Tarifa fija $60 MXN en radio de 5 km · gratis en compras mayores a $650 MXN.</li>
                <li>Zonas más lejanas: cotización por mensajería especializada.</li>
              </ul>
              <a className="btn btn-ghost" href={TIENDANUBE_URL} target="_blank" rel="noopener noreferrer" onClick={() => track("click_delivery", {})}>Elegir entrega</a>
            </Reveal>
          </div>
        </div>
      </div>
    </section>
  );
}

/* -------------------------------- FOUNDERS ------------------------------ */
function Founders() {
  const people = [
    { img: IMG.bruno, name: "Bruno Morales", role: "Maestro Panadero y Co-fundador", bio: "Estudió panadería tradicional en Barcelona y se especializó en harinas ecológicas molidas a la piedra. Lidera el trabajo de masa madre y fermentación lenta." },
    { img: IMG.paulina, name: "Paulina Estrada", role: "Chef Pastelera y Co-fundadora", bio: "Egresada del Centro Culinario Ambrosía con diplomado en L'École Valrhona en París. Prioriza balance de azúcares, frutas locales de temporada y flores comestibles." },
    { img: IMG.barra, name: "El equipo de barra", role: "Café de especialidad mexicano", bio: "Once personas sostienen el obrador, la vitrina y la barra: extracciones cuidadas de origen Oaxaca y Chiapas para acompañar cada pieza." },
  ];
  return (
    <section id="nosotros" className="section founders">
      <div className="container">
        <SectionHead eyebrow="Fundadores y obrador" title="Quienes hornean la historia." />
        <div className="founders-grid">
          {people.map((p, i) => (
            <Reveal key={p.name} delay={i * 0.12} className="founder-card">
              <div className="founder-media" data-cursor="view">
                <img src={p.img} alt={p.name} loading="lazy" width="640" height="760" />
              </div>
              <h3>{p.name}</h3>
              <p className="founder-role">{p.role}</p>
              <p className="founder-bio">{p.bio}</p>
            </Reveal>
          ))}
        </div>
        <svg className="flour-stroke" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden>
          <motion.path d="M40 24 C 300 6, 520 34, 760 16 S 1080 26, 1160 14" fill="none" stroke="var(--wheat)" strokeWidth="1.3"
            initial={{ pathLength: 0 }} whileInView={{ pathLength: 1 }} viewport={{ once: false, amount: 0.6 }} transition={{ duration: 1.6 }} />
        </svg>
      </div>
    </section>
  );
}

/* --------------------------------- GALLERY ------------------------------ */
function Gallery() {
  const [filter, setFilter] = useState("todos");
  const [lightbox, setLightbox] = useState(null);
  const items = useMemo(() => (filter === "todos" ? GALLERY : GALLERY.filter((g) => g.cat === filter)), [filter]);
  const closeRef = useRef(null);
  const lastTrigger = useRef(null);

  const open = (idx, e) => { lastTrigger.current = e?.currentTarget; setLightbox(idx); track("gallery_lightbox_opened", {}); };
  const close = useCallback(() => {
    setLightbox(null);
    lastTrigger.current?.focus?.();
  }, []);
  const step = useCallback((d) => {
    setLightbox((v) => (v === null ? v : (v + d + items.length) % items.length));
  }, [items.length]);

  useEffect(() => {
    if (lightbox === null) return undefined;
    const onKey = (e) => {
      if (e.key === "Escape") close();
      if (e.key === "ArrowRight") step(1);
      if (e.key === "ArrowLeft") step(-1);
    };
    window.addEventListener("keydown", onKey);
    closeRef.current?.focus();
    const prev = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    return () => { window.removeEventListener("keydown", onKey); document.body.style.overflow = prev; };
  }, [lightbox, close, step]);

  return (
    <section id="galeria" className="section gallery">
      <div className="container">
        <SectionHead eyebrow="La vitrina digital" title="Mira lo que sale del obrador." lead="Grid editorial, sin carruseles automáticos. Usa las flechas del teclado dentro del lightbox." />
        <div className="g-filters" role="group" aria-label="Filtros de galería">
          {GALLERY_FILTERS.map((f) => (
            <button key={f.id} className={`g-filter ${filter === f.id ? "on" : ""}`} aria-pressed={filter === f.id} onClick={() => setFilter(f.id)}>
              {f.label}
            </button>
          ))}
        </div>
        <motion.div layout className="g-grid">
          <AnimatePresence mode="popLayout">
            {items.map((g, i) => (
              <motion.figure layout key={g.src + g.title} className={`g-item g-span-${(i % 7) === 0 ? 2 : 1}`}
                initial={{ opacity: 0, scale: 0.94, clipPath: "inset(12% 12% 12% 12% round 20px)" }}
                animate={{ opacity: 1, scale: 1, clipPath: "inset(0% 0% 0% 0% round 20px)" }}
                exit={{ opacity: 0, scale: 0.95 }}
                transition={{ duration: 0.6, delay: (i % 6) * 0.05, ease: [0.22, 1, 0.36, 1] }}>
                <button className="g-btn" onClick={(e) => open(i, e)} data-cursor="view" aria-label={`Ampliar: ${g.title}`}>
                  <img src={g.src} alt={g.title} loading="lazy" width="640" height="640" />
                  <figcaption className="g-cap">
                    <strong>{g.title}</strong>
                    <span>{g.note}</span>
                  </figcaption>
                </button>
              </motion.figure>
            ))}
          </AnimatePresence>
        </motion.div>
      </div>
      <AnimatePresence>
        {lightbox !== null && items[lightbox] && (
          <motion.div className="lightbox" role="dialog" aria-modal="true" aria-label={items[lightbox].title}
            initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} onClick={close}>
            <motion.div className="lightbox-in" initial={{ scale: 0.92, opacity: 0 }} animate={{ scale: 1, opacity: 1 }} exit={{ scale: 0.95, opacity: 0 }} transition={{ duration: 0.35 }} onClick={(e) => e.stopPropagation()}>
              <button className="lb-close" ref={closeRef} onClick={close} aria-label="Cerrar (Escape)"><Ico.x width="20" height="20" /></button>
              <button className="lb-nav lb-prev" onClick={() => step(-1)} aria-label="Anterior (flecha izquierda)">‹</button>
              <img src={items[lightbox].src} alt={items[lightbox].title} />
              <div className="lb-cap">
                <strong>{items[lightbox].title}</strong>
                <p>{items[lightbox].note}</p>
              </div>
              <button className="lb-nav lb-next" onClick={() => step(1)} aria-label="Siguiente (flecha derecha)">›</button>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </section>
  );
}

/* ------------------------------ CLUB MASA MADRE ------------------------- */
function ClubMasaMadre() {
  const [joined, setJoined] = useState("");
  const [email, setEmail] = useState("");
  return (
    <section id="club" className="section club">
      <div className="container">
        <SectionHead eyebrow="Club Masa Madre" title="Tu pan de cada semana tiene recompensa." align="center" />
        <div className="club-stamps" aria-label="Tarjeta de fidelidad: nueve hogazas y la décima de cortesía">
          {Array.from({ length: 10 }).map((_, i) => (
            <motion.span key={i} className={`club-stamp ${i === 9 ? "gold" : ""}`}
              initial={{ opacity: 0, scale: 0.6, rotate: -8 }}
              whileInView={{ opacity: 1, scale: 1, rotate: 0 }}
              viewport={{ once: false, amount: 0.5 }}
              transition={{ delay: i * 0.08, type: "spring", stiffness: 180, damping: 16 }}>
              <WheatSeal size={46} />
              {i === 9 && <motion.i className="gold-glow" initial={{ opacity: 0 }} whileInView={{ opacity: [0, 1, 0.35] }} viewport={{ once: false, amount: 0.6 }} transition={{ delay: 0.9, duration: 1.4 }} aria-hidden />}
            </motion.span>
          ))}
        </div>
        <div className="club-benefits">
          {[
            "Tarjeta digital en Apple Wallet / Google Wallet.",
            "Por cada 9 hogazas compradas, la décima es de cortesía.",
            "10% en café al llevar tu propio termo.",
          ].map((b, i) => (
            <Reveal key={b} y={14} blur={false} delay={i * 0.1} className="club-benefit">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--olive)" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden>
                <motion.path d="m4 12.5 5 5L20 6.5" initial={{ pathLength: 0 }} whileInView={{ pathLength: 1 }} viewport={{ once: false, amount: 0.6 }} transition={{ duration: 0.5, delay: 0.2 + i * 0.1 }} />
              </svg>
              <span>{b}</span>
            </Reveal>
          ))}
        </div>
        <Reveal y={16} blur={false} className="club-cta">
          {joined ? (
            <p className="form-success-inline" role="status">¡Listo, {joined}! Te enviamos tu tarjeta digital a {email}. <Ico.wheat width="15" height="15" /></p>
          ) : (
            <form className="club-form" onSubmit={(e) => { e.preventDefault(); if (!/^\S+@\S+\.\S+$/.test(email)) return; setJoined("bienvenido"); track("club_signup", {}); }}>
              <label className="sr-only" htmlFor="club-name">Nombre</label>
              <input id="club-name" placeholder="Tu nombre" value={joined} onChange={(e) => setJoined(e.target.value)} required />
              <label className="sr-only" htmlFor="club-email">Correo</label>
              <input id="club-email" type="email" placeholder="tu@correo.mx" value={email} onChange={(e) => setEmail(e.target.value)} required />
              <button className="btn btn-primary" type="submit">Unirme al Club Masa Madre</button>
            </form>
          )}
        </Reveal>
      </div>
    </section>
  );
}

/* -------------------------------- GIFT CARDS ---------------------------- */
function GiftCards() {
  const [amount, setAmount] = useState(500);
  return (
    <section id="gift-cards" className="section gifts">
      <div className="container">
        <div className="gifts-grid">
          <Reveal y={26} className="gift-visual">
            <div className="envelope" aria-hidden>
              <motion.div className="env-card" initial={{ y: 40, rotate: -3 }} whileInView={{ y: 0, rotate: 0 }} viewport={{ once: false, amount: 0.4 }} transition={{ duration: 1.0, ease: [0.22, 1, 0.36, 1] }}>
                <WheatSeal size={44} />
                <p>Masa & Trigo</p>
                <strong>${amount} MXN</strong>
                <span>Regala una mañana que se disfruta despacio.</span>
              </motion.div>
              <div className="env-body" />
            </div>
          </Reveal>
          <div className="gifts-copy">
            <SectionHead eyebrow="Gift Cards" title="Regala una mañana que se disfruta despacio." lead="Digitales, con dedicatoria por email y canjeables en tienda física y tienda web." />
            <div className="gift-amounts" role="group" aria-label="Monto de gift card">
              {[300, 500, 1000].map((m, i) => (
                <Reveal key={m} y={12} blur={false} delay={i * 0.08}>
                  <button className={`gift-tag ${amount === m ? "on" : ""}`} aria-pressed={amount === m} onClick={() => setAmount(m)}
                    style={{ rotate: amount === m ? "0deg" : `${(i - 1) * 1.6}deg` }}>
                    ${m}
                  </button>
                </Reveal>
              ))}
            </div>
            <Reveal y={14} blur={false} delay={0.2}>
              <a className="btn btn-primary btn-lg" href={TIENDANUBE_URL} target="_blank" rel="noopener noreferrer" data-cursor="cta"
                onClick={() => track("click_gift_card", { amount })}>Elegir una Gift Card</a>
            </Reveal>
          </div>
        </div>
      </div>
    </section>
  );
}

